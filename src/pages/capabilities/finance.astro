---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import StickySubnav from '@/components/StickySubnav.astro';
import KeyFactsBlock from '@/components/KeyFactsBlock.astro';
import ComparisonTable from '@/components/ComparisonTable.astro';
import FAQBlock from '@/components/FAQBlock.astro';
import PageByline from '@/components/PageByline.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { getCollection } from 'astro:content';
import { buildFaqPageSchema, buildServiceSchema, SITE_URL } from '@/lib/schema';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.data.category === 'finance')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'fpa', label: 'FP&A' },
  { id: 'ai-forecasting', label: 'AI Forecasting' },
  { id: 'funding-growth', label: 'Funding Growth' },
  { id: 'compare', label: 'Compare Options' },
  { id: 'faq', label: 'FAQ' },
];

const faqItems = [
  {
    question: 'Is this the same as hiring a fractional CFO?',
    answer:
      'It overlaps, but the emphasis is different. A fractional CFO is typically a generalist finance leader; NCR Digital\'s Finance pillar is specifically about building the financial model and forecasting infrastructure that lets a growth company evaluate and fund its own marketing and operations decisions, often working alongside an existing finance hire rather than replacing one.',
  },
  {
    question: 'What does "AI-assisted" mean in FP&A work?',
    answer:
      'It means using AI tools to accelerate scenario modeling, variance analysis, and forecast iteration, not replacing financial judgment with an algorithm. The model and its assumptions are still built and owned by a human; AI tooling shortens the cycle time between "what if we changed X" and having a real answer.',
  },
  {
    question: 'Do I need the Marketing pillar first, or can Finance stand alone?',
    answer:
      'Finance work stands alone. Plenty of engagements start here, especially companies preparing for a raise or trying to understand their unit economics before scaling spend. It\'s common for Finance modeling to reveal exactly how much budget the Marketing pillar should actually get.',
  },
];
const faqSchema = buildFaqPageSchema(faqItems);

const serviceSchema = buildServiceSchema({
  id: `${SITE_URL}/capabilities/finance#service`,
  name: 'FP&A & Finance Strategy',
  serviceType: 'Financial Planning & Analysis',
  description:
    'Financial modeling, forecasting, and AI-assisted FP&A strategy for high-growth companies: the financial infrastructure that funds marketing and operations decisions.',
});
---

<Layout
  title="Finance: FP&A & Financial Modeling | NCR Digital"
  description="NCR Digital's Finance pillar builds the financial modeling, forecasting, and AI-assisted FP&A infrastructure that lets high-growth companies fund and evaluate their own marketing and operations decisions."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />

  <Navigation />
  <main id="main-content">
    <SectionHero
      eyebrow="Capability"
      title="Finance: The Financial Infrastructure That Funds Growth"
      subtitle="NCR Digital's Finance pillar builds FP&A and financial-modeling infrastructure so growth decisions (how much to spend on marketing, when to hire, what a raise should look like) are made against real numbers, not intuition."
      size="lg"
    />

    <StickySubnav sections={sections} />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <PageByline author="Niekos Robbins" publishedDate={new Date('2026-03-01')} />
    </div>

    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-16">
      <section id="overview">
        <p class="text-lg text-ncr-text leading-relaxed">
          <strong>NCR Digital's Finance pillar builds the financial modeling and forecasting infrastructure
          that high-growth companies need to fund and evaluate their own decisions, most often the decisions
          coming out of the Marketing and Operations pillars.</strong> Marketing can find growth; Finance
          determines whether the company can actually afford to capitalize on it, and builds the model that
          answers that question with numbers instead of instinct.
        </p>
        <p class="text-ncr-muted leading-relaxed mt-6">
          This pillar exists because of a pattern that shows up constantly in growth-stage companies: a
          marketing or product initiative proves it can generate demand, but nobody has built the financial
          model to know whether scaling that initiative is actually profitable at the unit-economics level,
          or how much runway it costs to find out. Finance closes that gap.
        </p>
      </section>

      <ScrollReveal>
      <section id="fpa">
        <h2 class="text-2xl sm:text-display-md font-bold tracking-tight text-ncr-text mb-4">
          What does FP&A work actually involve?
        </h2>
        <p class="text-ncr-text leading-relaxed">
          <strong>FP&A (financial planning and analysis) is the discipline of building a company's forecast,
          tracking actuals against it, and explaining the variance: the three-way loop that turns a
          spreadsheet into a decision-making tool.</strong> NCR Digital's FP&A work covers:
        </p>
        <ul class="mt-4 space-y-2 text-ncr-muted">
          <li class="flex items-start gap-2"><span class="text-ncr-cyan mt-0.5" aria-hidden="true">→</span> Building or rebuilding the core financial model (revenue, cost, cash) from scratch or from an existing spreadsheet that's outgrown its structure.</li>
          <li class="flex items-start gap-2"><span class="text-ncr-cyan mt-0.5" aria-hidden="true">→</span> Scenario and sensitivity modeling: what happens to runway if CAC rises 20%, or if a launch slips a quarter.</li>
          <li class="flex items-start gap-2"><span class="text-ncr-cyan mt-0.5" aria-hidden="true">→</span> Monthly variance analysis, tying actuals back to the forecast and explaining the delta in plain terms.</li>
          <li class="flex items-start gap-2"><span class="text-ncr-cyan mt-0.5" aria-hidden="true">→</span> Board- and investor-ready reporting that presents the model's output, not just the raw numbers.</li>
        </ul>
      </section>
      </ScrollReveal>

      <ScrollReveal>
      <section id="ai-forecasting">
        <h2 class="text-2xl sm:text-display-md font-bold tracking-tight text-ncr-text mb-4">
          What actually changes when AI enters the forecasting process?
        </h2>
        <p class="text-ncr-text leading-relaxed">
          <strong>AI tooling changes the cycle time of FP&A work, not the underlying judgment: scenario
          modeling that used to take a day of spreadsheet rework can be iterated in minutes, and variance
          explanations that used to require manually cross-referencing line items can be drafted from
          structured data automatically.</strong> The risk worth naming directly: AI-generated forecasts are
          only as good as the assumptions and data structure underneath them: a model built on messy,
          un-categorized transaction data will produce a fast, confident, wrong answer just as easily as a
          slow one. NCR Digital's approach is to fix the data structure and assumption set first, then use AI
          tooling to accelerate iteration on top of a model that's actually sound.
        </p>
      </section>
      </ScrollReveal>

      <ScrollReveal>
      <section id="funding-growth">
        <h2 class="text-2xl sm:text-display-md font-bold tracking-tight text-ncr-text mb-4">
          How does the Finance pillar connect to fundraising and burn management?
        </h2>
        <p class="text-ncr-text leading-relaxed">
          <strong>The same model that sizes a marketing budget also sizes a fundraise: both require a
          defensible answer to "how much does this cost, and for how long."</strong> NCR Digital's Finance work
          extends into fundraising and investor-readiness support (translating the operating model into the
          format investors expect) and cash-flow/burn-rate optimization (identifying where runway is being
          spent inefficiently before it becomes a crisis, rather than after).
        </p>
      </section>
      </ScrollReveal>

      <KeyFactsBlock
        title="Key Facts"
        facts={[
          'The Finance pillar builds FP&A and financial-modeling infrastructure, most often to evaluate Marketing and Operations decisions.',
          'Core FP&A loop: build the model, forecast, track actuals, explain variance.',
          'AI tooling accelerates scenario iteration and variance analysis. It does not replace the underlying assumption-building work.',
          'A sound data structure and assumption set must exist before AI forecasting tools add real value, not just speed.',
          'Finance work extends to fundraising/investor-readiness support and cash-flow/burn-rate optimization.',
        ]}
      />

      <div id="compare">
        <ComparisonTable
          caption="Ways to Get FP&A Support"
          columns={['Full-Time CFO Hire', 'Fractional CFO', 'NCR Digital Finance Pillar']}
          rows={[
            { label: 'Cost structure', cells: ['Highest (full salary plus equity).', 'Lower, ongoing retainer.', 'Scoped per engagement, project or retainer.'] },
            { label: 'Focus', cells: ['Broad financial leadership.', 'Broad financial leadership, part-time.', 'Modeling and forecasting infrastructure specifically, often alongside an existing finance hire.'] },
            { label: 'Best fit', cells: ['Later-stage companies with complex finance needs.', 'Companies needing an executive presence without full-time cost.', 'Companies that need the model built or rebuilt, with or without other finance leadership already in place.'] },
          ]}
        />
      </div>

      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-heading">
          <h2 id="related-heading" class="text-xl font-bold text-ncr-text mb-4">Related Insights</h2>
          <ul class="space-y-3">
            {relatedPosts.map((post) => (
              <li>
                <a href={`/insights/${post.slug}/`} class="text-ncr-cyan hover:underline font-medium">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div id="faq">
        <FAQBlock items={faqItems} />
      </div>

      <div>
        <a
          href="/contact"
          class="inline-flex px-6 py-3 bg-ncr-cyan text-white text-sm font-medium tracking-wide hover:bg-ncr-cyan/90 transition-all duration-200"
        >
          Talk to Us About Finance
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
