---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import KeyFactsBlock from '@/components/KeyFactsBlock.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const credentials = [
  'Scaled organic search for a high-growth automotive SaaS platform, the case study behind most of the numbers on this site.',
  'Every SEO recommendation is checked against Search Console and GA4 data before it ships, not against a best practices list.',
  'AI strategy work is grounded in the same financial-modeling discipline: nothing gets recommended without a model behind it.',
];

const teamExperience = [
  'MBB management-consulting experience, applied to how engagements are scoped and structured.',
  'Experience at a leading AI consultancy, informing how AI adoption is sequenced.',
  'Finance research experience underpinning the modeling work behind AI strategy engagements.',
];
---

<Layout
  title="About NCR Digital | SEO & AI Strategy"
  description="NCR Digital is a boutique consultancy built on one idea: a firm that does two things well beats one that does five adequately."
>
  <Navigation />
  <main id="main-content">
    <SectionHero
      eyebrow="About"
      title="Two disciplines, done properly."
      subtitle="NCR Digital pairs technical SEO and AI-answer visibility with AI strategy grounded in financial modeling. Every recommendation here has to survive contact with a number."
    />

    <section class="py-16 sm:py-24" aria-labelledby="about-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-ncr-muted text-xs mb-10">
          Last reviewed <time datetime="2026-08-11">August 11, 2026</time>
        </p>
        <div class="grid lg:grid-cols-3 gap-14 items-start">
          <div class="lg:col-span-2 space-y-6 text-ncr-muted leading-relaxed">
            <h2 id="about-heading" class="font-display text-2xl sm:text-display-md text-ncr-text mb-2">
              Who we are
            </h2>
            <p>
              NCR Digital started as technical SEO work: fixing crawl budgets, rebuilding content
              silos, closing the gap between a site's actual structure and what it needed to rank.
              That work is still the core of the firm. What's changed is the second half of the
              practice: AI strategy consulting, built on the same instinct that made the SEO work
              land, that a recommendation only counts if it's checked against real data, not
              intuition or a template.
            </p>
            <p class="border-l-2 border-ncr-accent/40 pl-4 italic text-sm">
              Based in Texas, NCR Digital is an independent boutique consultancy. We are not
              affiliated with NCR Voyix or traditional banking hardware corporations.
            </p>
            <p>
              A traffic dip that looks like a content problem is usually a crawl-budget problem. An
              AI rollout that looks like a tooling problem is usually a sequencing problem nobody
              modeled first. The discipline is the same in both cases: read the underlying data
              correctly before recommending a fix, and say so plainly when something is a hypothesis
              rather than a proven pattern.
            </p>
          </div>

          <div class="rounded-card border border-ncr-border bg-ncr-card p-8">
            <div class="w-20 h-20 rounded-card border-2 border-ncr-accent flex items-center justify-center font-display text-2xl text-ncr-accent mb-6" aria-hidden="true">
              NCR
            </div>
            <p class="text-ncr-text font-semibold">NCR Digital</p>
            <p class="text-ncr-muted text-sm mt-1">SEO and AI strategy consultancy</p>
            <p class="text-ncr-muted text-sm mt-4">College Station, TX · working with clients globally</p>

            <div class="mt-6 pt-6 border-t border-ncr-border">
              <p class="text-ncr-text text-sm font-medium">Niekos Robbins</p>
              <p class="text-ncr-muted text-xs mt-0.5">Founder</p>
              <p class="text-ncr-muted text-xs mt-2">Texas A&M University</p>
              <a
                href="https://www.linkedin.com/in/niekolas-robbins"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-ncr-accent text-xs font-medium mt-2 underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent"
              >
                LinkedIn
              </a>
            </div>

            <a
              href="/contact"
              class="inline-flex items-center gap-1.5 text-ncr-accent text-sm font-medium mt-6 underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent"
            >
              Get in touch
            </a>
          </div>
        </div>

        <p class="text-ncr-muted text-sm mt-6">
          For the legal and operating details behind NCR Digital, see <a href="/credentials" class="text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">Credentials</a>.
        </p>

        <ScrollReveal>
          <KeyFactsBlock title="Key facts" facts={credentials} />
        </ScrollReveal>

        <section aria-labelledby="team-heading" class="mt-4">
          <h2 id="team-heading" class="font-display text-2xl sm:text-display-md text-ncr-text mb-4">
            Team experience
          </h2>
          <p class="text-ncr-muted leading-relaxed max-w-3xl mb-2">
            Engagements draw on management consulting rigor, AI consulting practice, and hands-on
            finance research, brought together under one team rather than referred out.
          </p>
          <ScrollReveal>
            <KeyFactsBlock title="Team experience" facts={teamExperience} />
          </ScrollReveal>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
