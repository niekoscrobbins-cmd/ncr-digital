---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import KeyFactsBlock from '@/components/KeyFactsBlock.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const credentials = [
  'Scaled organic search for a leading automotive SaaS platform',
  'Applies financial-modeling discipline to marketing, not just reporting',
  'Builds AI-adoption and FP&A practices with the same technical rigor applied to every engagement',
  'NCR Digital: AI strategy across Marketing, Finance, and Operations',
];

const teamExperience = [
  'MBB management consulting experience, applied to how engagements are scoped and structured.',
  'Experience at a leading AI consultancy, informing the Operations pillar\'s tooling and adoption approach.',
  'Finance research experience underpinning the Finance pillar\'s modeling work.',
  'Financial modeling expertise applied consistently across Marketing ROI, Finance forecasting, and Operations business cases.',
];
---

<Layout
  title="About NCR Digital | AI Strategy Consultancy"
  description="NCR Digital is a boutique AI strategy consultancy built on the principle that most growth problems are read wrong when marketing, finance, and operations are treated as separate disciplines."
>
  <Navigation />
  <main id="main-content">
    <SectionHero
      eyebrow="About"
      title="Most agencies chase one number. We chase the whole system."
      subtitle="NCR Digital was built on a conviction: growth problems don't respect department lines. Marketing, finance, and operations are one system, and treating them separately is why most AI initiatives stall."
    />

    <section class="py-16 sm:py-24" aria-labelledby="about-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-14 items-start">
          <div class="lg:col-span-2 space-y-6 text-ncr-muted leading-relaxed">
            <h2 id="about-heading" class="text-2xl sm:text-display-md font-bold tracking-tight text-ncr-text mb-2">
              Who We Are
            </h2>
            <p>
              NCR Digital exists because most growth problems get misdiagnosed. A traffic dip gets treated as
              a content problem when it's a crawl-budget problem. A forecasting miss gets treated as a finance
              problem when it's a data-quality problem. The team's edge is
              <span class="text-ncr-text font-medium"> bridging the gap between raw data and financial outcomes</span>,
              reading the technical signal underneath the business symptom, then acting on it, whether that
              shows up in a site's crawl logs, a company's financial model, or its operational tooling.
            </p>
            <p class="border-l-2 border-ncr-cyan/40 pl-4 italic text-sm">
              Based in Texas, NCR Digital is an independent boutique consultancy. We are not affiliated with
              NCR Voyix or traditional banking hardware corporations.
            </p>
            <p>
              Marketing, Finance, and Operations operate as one system at NCR Digital, not three referral
              relationships. The same discipline that diagnoses why a site isn't ranking is applied to why a
              forecast doesn't hold up or why an AI rollout stalls:
              <span class="text-ncr-text font-medium"> read the data correctly, then fix the structure
              underneath it</span>. That's why engagements stay in-house across all three pillars instead of
              being handed off elsewhere.
            </p>
          </div>

          <div class="border border-ncr-border bg-ncr-card p-8">
            <div class="w-20 h-20 border-2 border-ncr-cyan flex items-center justify-center font-mono text-2xl font-bold text-ncr-cyan mb-6" aria-hidden="true">
              NCR
            </div>
            <p class="text-ncr-text font-semibold">NCR Digital</p>
            <p class="text-ncr-muted text-sm mt-1">Boutique AI Strategy Consultancy</p>
            <p class="text-ncr-muted text-sm mt-4">College Station, TX · Serving Global Ventures</p>
            <a
              href="/contact"
              class="inline-flex items-center gap-1.5 text-ncr-cyan text-sm font-medium mt-4 hover:underline"
            >
              Get in Touch →
            </a>
          </div>
        </div>

        <ScrollReveal>
          <KeyFactsBlock title="Key Facts" facts={credentials} />
        </ScrollReveal>

        <section aria-labelledby="team-heading" class="mt-4">
          <h2 id="team-heading" class="text-2xl sm:text-display-md font-bold tracking-tight text-ncr-text mb-4">
            Team Experience
          </h2>
          <p class="text-ncr-muted leading-relaxed max-w-3xl mb-2">
            Engagements draw on experience most boutique consultancies don't have in-house: management
            consulting rigor, AI consulting practice, and hands-on finance research, brought together under
            one team rather than referred out.
          </p>
          <ScrollReveal>
            <KeyFactsBlock title="Team Experience" facts={teamExperience} />
          </ScrollReveal>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
