---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import StatBar from '@/components/StatBar.astro';
import CapabilityCardGrid from '@/components/CapabilityCardGrid.astro';
import CaseStudyBlock from '@/components/CaseStudyBlock.astro';
import FAQBlock from '@/components/FAQBlock.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { capabilities } from '@/data/capabilities';
import { caseStudy } from '@/data/proof';
import { buildFaqPageSchema } from '@/lib/schema';

const faqItems = [
  {
    question: 'What does NCR Digital actually do?',
    answer:
      'Two things: organic search (technical SEO and AI answer visibility) and AI strategy consulting (adoption sequencing and financial modeling). We don\'t run paid media, and we don\'t offer broad finance or operations leadership.',
  },
  {
    question: 'Do you work project-based or on retainer?',
    answer:
      'Both. A project is a specific deliverable we build and hand off. A subscription is ongoing work we keep running with you. See /how-we-work for the comparison.',
  },
  {
    question: 'Which capability should I start with?',
    answer:
      'If visibility is the bottleneck, start with SEO. If you\'re trying to size whether an AI initiative is worth funding before committing to it, start with AI strategy. Most engagements need only one.',
  },
  {
    question: 'Who is behind NCR Digital?',
    answer:
      'NCR Digital was founded by Niekos Robbins, who scaled organic search for a high-growth automotive SaaS platform before founding the firm. See /about for the full story.',
  },
];

const faqSchema = buildFaqPageSchema(faqItems);

// Derived from src/data/proof.ts rather than hand-copied, so the homepage
// stat bar and CaseStudyBlock can't drift into stating two different values
// (or two different meanings) for the same metric again.
const drMetric = caseStudy.metrics.find((m) => m.key === 'dr')!;
const trafficMetric = caseStudy.metrics.find((m) => m.key === 'traffic')!;
const drStart = caseStudy.drProgress[0].dr;
const drEnd = caseStudy.drProgress[caseStudy.drProgress.length - 1].dr;
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <Navigation />

  <main id="main-content">
    <SectionHero
      eyebrow="NCR Digital"
      title="We help you get found, then know what to build next."
      subtitle="Organic search and AI strategy for companies that would rather see the number than trust the pitch. We fix what's stopping a site from being found, and we model what an AI initiative is actually worth before you fund it."
      ctaLabel="Book a call"
      ctaHref="/contact"
      secondaryCtaLabel="See how we work"
      secondaryCtaHref="/how-we-work"
    />

    <section id="stats" class="pb-16 sm:pb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal>
          <StatBar
            stats={[
              { value: `DR ${drEnd}`, label: 'Domain Rating at handoff', sub: `Case study below · ${drMetric.source}`, countTo: drEnd, decimals: 0, prefix: 'DR ' },
              { value: '7 mo', label: `DR ${drStart}→${drEnd} engagement`, sub: 'Case study below', countTo: 7, decimals: 0, suffix: ' mo' },
              { value: trafficMetric.value, label: 'Organic traffic growth', sub: `${trafficMetric.sub} · case study below`, countTo: trafficMetric.countTo, decimals: trafficMetric.decimals, suffix: trafficMetric.suffix },
            ]}
          />
        </ScrollReveal>
      </div>
    </section>

    <section id="capabilities" class="py-16 sm:py-24 bg-ncr-surface" aria-labelledby="capabilities-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="mb-14 max-w-2xl">
          <p class="text-xs tracking-wide uppercase text-ncr-muted mb-4">What we do</p>
          <h2 id="capabilities-heading" class="font-display text-3xl sm:text-display-md text-ncr-text">
            Two disciplines. No adjacent services.
          </h2>
        </header>
        <ScrollReveal>
          <CapabilityCardGrid
            cards={capabilities.map(({ label, description, href }) => ({ title: label, description, href }))}
          />
        </ScrollReveal>
      </div>
    </section>

    <ScrollReveal>
      <CaseStudyBlock />
    </ScrollReveal>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <FAQBlock items={faqItems} />
    </div>

    <section class="py-16 sm:py-24 border-t border-ncr-border" aria-labelledby="cta-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-start gap-6">
        <h2 id="cta-heading" class="font-display text-3xl sm:text-display-md text-ncr-text">
          Ready to talk?
        </h2>
        <p class="text-ncr-muted max-w-xl">
          Tell us where you are and where you need to be. We'll tell you which capability fits.
        </p>
        <a
          href="/contact"
          class="px-6 py-3 rounded-pill bg-ncr-accent text-white text-sm font-medium hover:bg-ncr-accentHover transition-all duration-200"
        >
          Book a call
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Scroll-triggered count-up on the stat bar and the case-study metrics/DA
  // bars. No scroll-pin: hijacking scroll position to force a viewer to
  // watch numbers count up reads as a template effect rather than a design
  // choice, so this only plays the count-up once each section is in view.
  // Gated entirely behind prefers-reduced-motion — the DOM default already
  // shows the correct final content (real stat/metric values, bars at their
  // real final width), so reduced-motion and JS-disabled visitors both
  // simply see that default with no animation.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const schedule = () => {
      initScrollAnimations().catch(() => {
        // If GSAP fails to load for any reason, the page is already correct
        // without it (see comment above).
      });
    };
    const ric = (window as unknown as { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void })
      .requestIdleCallback;
    if (ric) {
      ric(schedule, { timeout: 2000 });
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  }

  function countUp(
    gsap: typeof import('gsap').gsap,
    el: HTMLElement,
    { from = 0 }: { from?: number } = {}
  ) {
    const to = parseFloat(el.dataset.countTo ?? '0');
    const decimals = parseInt(el.dataset.decimals ?? '0', 10);
    const prefix = el.dataset.prefix ?? '';
    const suffix = el.dataset.suffix ?? '';
    const proxy = { val: from };
    el.textContent = `${prefix}${proxy.val.toFixed(decimals)}${suffix}`;
    gsap.to(proxy, {
      val: to,
      duration: 1.2,
      ease: 'power2.out',
      onUpdate: () => {
        el.textContent = `${prefix}${proxy.val.toFixed(decimals)}${suffix}`;
      },
    });
  }

  async function initScrollAnimations() {
    const { gsap } = await import('gsap');

    // --- Stat bar: count each value up once in view, no pin ---
    const statEls = Array.from(document.querySelectorAll<HTMLElement>('.stat-value[data-count-to]'));
    if (statEls.length) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          statEls.forEach((el) => countUp(gsap, el));
        },
        { threshold: 0.5 }
      );
      const statSection = document.querySelector<HTMLElement>('#stats');
      if (statSection) io.observe(statSection);
    }

    // --- Case study: metrics + DR trajectory bars ---
    const caseStudySection = document.querySelector<HTMLElement>('#case-study');
    const metricEls = Array.from(document.querySelectorAll<HTMLElement>('.metric-value[data-count-to]'));
    const barEls = Array.from(document.querySelectorAll<HTMLElement>('.dr-bar-fill[data-target-width]'));

    if (caseStudySection && (metricEls.length || barEls.length)) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          metricEls.forEach((el) => countUp(gsap, el, { from: parseFloat(el.dataset.countFrom ?? '0') }));
          barEls.forEach((el) => {
            const target = el.dataset.targetWidth ?? '0';
            el.style.width = '0%';
            gsap.to(el, { width: `${target}%`, duration: 1, ease: 'power2.out' });
          });
        },
        { threshold: 0.3 }
      );
      io.observe(caseStudySection);
    }
  }
</script>
