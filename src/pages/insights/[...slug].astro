---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import PageByline from '@/components/PageByline.astro';
import KeyFactsBlock from '@/components/KeyFactsBlock.astro';
import FAQBlock from '@/components/FAQBlock.astro';
import { buildBreadcrumbSchema, buildFaqPageSchema, ORG_ID, FOUNDER_ID, SITE_URL } from '@/lib/schema';
import { capabilityBySlug } from '@/data/capabilities';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();

const capability = capabilityBySlug[post.data.category];

// Resolve absolute image URL, used by schema, OG, and Twitter tags
const absoluteImage = post.data.image ? `${SITE_URL}${post.data.image}` : undefined;

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@id': FOUNDER_ID },
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
  ...(absoluteImage ? { image: absoluteImage } : { image: `${SITE_URL}/og-main-cover.png` }),
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', item: `${SITE_URL}/` },
  { name: 'Insights', item: `${SITE_URL}/insights/` },
  { name: post.data.title, item: Astro.url.href },
]);

const faqSchema = post.data.faq && post.data.faq.length > 0 ? buildFaqPageSchema(post.data.faq) : null;
---

<Layout
  title={`${post.data.title} | NCR Digital`}
  description={post.data.description}
  ogImage={absoluteImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}

  <Navigation />

  <main id="main-content">
    <header class="pt-32 pb-12 sm:pt-40 sm:pb-16 bg-ncr-bg border-b border-ncr-border">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex items-center gap-2 text-xs text-ncr-muted">
            <li><a href="/" class="hover:text-ncr-accent transition-colors">Home</a></li>
            <li aria-hidden="true" class="text-ncr-rule">/</li>
            <li><a href="/insights/" class="hover:text-ncr-accent transition-colors">Insights</a></li>
            <li aria-hidden="true" class="text-ncr-rule">/</li>
            <li class="text-ncr-muted/70 truncate max-w-[200px]" aria-current="page">{post.data.title}</li>
          </ol>
        </nav>

        <p class="mb-4">
          <a href={capability.href} class="text-[11px] tracking-wide uppercase text-ncr-accent bg-ncr-surface rounded-pill px-2.5 py-1 hover:bg-ncr-accent hover:text-white transition-colors">
            {capability.label}
          </a>
        </p>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-display-lg leading-tight text-ncr-text mb-6">
          {post.data.title}
        </h1>

        <p class="text-ncr-muted text-lg leading-relaxed mb-6">
          {post.data.description}
        </p>

        <PageByline author={post.data.author} publishedDate={post.data.pubDate} updatedDate={post.data.updatedDate} />

        {post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-5" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <li class="text-[11px] tracking-wide uppercase text-ncr-muted bg-ncr-surface rounded-pill px-2.5 py-1">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <article class="py-16 bg-ncr-surface" aria-label={post.data.title}>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        {absoluteImage && (
          <div class="mb-12 border border-ncr-border rounded-card overflow-hidden">
            <img
              src={absoluteImage}
              alt={post.data.imageAlt ?? post.data.title}
              width="1200"
              height="630"
              class="w-full h-auto object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        {post.data.keyFacts && post.data.keyFacts.length > 0 && (
          <KeyFactsBlock facts={post.data.keyFacts} />
        )}

        <div class="ncr-prose">
          <Content />
        </div>

        {post.data.faq && post.data.faq.length > 0 && (
          <FAQBlock items={post.data.faq} title="FAQ" />
        )}

        <div class="mt-12 p-6 border border-ncr-border rounded-card bg-ncr-card">
          <p class="text-ncr-muted text-sm mb-2">This post is part of the {capability.label} capability.</p>
          <a href={capability.href} class="text-ncr-accent font-medium underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">
            See the full {capability.label} capability
          </a>
        </div>

        <div class="mt-10 pt-8 border-t border-ncr-border">
          <a
            href="/insights/"
            class="text-sm text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent"
          >
            Back to Insights
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Prose styles for rendered markdown, scoped via .ncr-prose.
     Colour values come from the :root tokens declared in Layout.astro. */
  .ncr-prose {
    color: var(--ncr-text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Article headings take the display serif at a normal weight — the same
     rule as the rest of the site, so a post reads as one system with it. */
  .ncr-prose h2 {
    font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
    color: var(--ncr-text);
    font-size: 1.75rem;
    font-weight: 450;
    letter-spacing: -0.008em;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .ncr-prose h3 {
    color: var(--ncr-text);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .ncr-prose p {
    margin-top: 0;
    margin-bottom: 1.35rem;
  }

  .ncr-prose a {
    color: var(--ncr-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(23, 50, 72, 0.3);
    transition: text-decoration-color 0.2s;
  }

  .ncr-prose a:hover {
    text-decoration-color: var(--ncr-accent);
  }

  .ncr-prose strong {
    color: var(--ncr-text);
    font-weight: 600;
  }

  .ncr-prose ul,
  .ncr-prose ol {
    padding-left: 1.25rem;
    margin-bottom: 1.35rem;
  }

  /* Real list markers rather than a mono arrow glyph. */
  .ncr-prose ul { list-style-type: disc; }
  .ncr-prose ol { list-style-type: decimal; }
  .ncr-prose li { margin-bottom: 0.5rem; padding-left: 0.35rem; }
  .ncr-prose li::marker { color: var(--ncr-rule); }

  .ncr-prose code:not(pre code) {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.85em;
    color: var(--ncr-text);
    background: var(--ncr-surface);
    border: 1px solid var(--ncr-border);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .ncr-prose pre {
    background: var(--ncr-text);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border-radius: 10px;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #f2eee8;
  }

  .ncr-prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Pull quote: display serif, no italic — the variable font ships upright
     only, so an italic here would be a synthesised slant. */
  .ncr-prose blockquote {
    font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
    font-size: 1.375rem;
    line-height: 1.45;
    color: var(--ncr-text);
    border-left: 2px solid var(--ncr-rule);
    padding-left: 1.5rem;
    margin: 2rem 0;
  }

  .ncr-prose blockquote p { margin-bottom: 0.5rem; }

  .ncr-prose hr {
    border: none;
    border-top: 1px solid var(--ncr-border);
    margin: 2.5rem 0;
  }

  /* Markdown pipe-tables. No post used a table before this pass, despite
     the site's own GEO position (see ai-answer-engines-citation.md) that
     tables outperform prose because they're already citable in tabular
     shape — so this styling didn't exist yet either. */
  /* Square, not rounded: markdown tables render as a bare <table> with no
     wrapper div available to put a radius on, and Safari won't round the
     corners of a border-collapse: collapse table itself. Matches
     ComparisonTable.astro's own inner <table>, which is square for the
     same reason — its radius lives on a wrapper div this content can't
     have. Kept full-width rather than horizontally scrollable, since posts
     only use small 2-4 column tables. */
  .ncr-prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    border: 1px solid var(--ncr-border);
  }

  .ncr-prose th,
  .ncr-prose td {
    text-align: left;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--ncr-border);
    vertical-align: top;
  }

  .ncr-prose th {
    font-weight: 600;
    color: var(--ncr-text);
    background: var(--ncr-surface);
  }

  .ncr-prose td {
    color: var(--ncr-muted);
  }
</style>
