---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import { capabilityBySlug } from '@/data/capabilities';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date): string {
  // timeZone: 'UTC' pinned for the same reason as PageByline.astro: frontmatter
  // dates parse as UTC midnight, so an unpinned format can render a day early.
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<Layout
  title="Insights | NCR Digital"
  description="Technical SEO walkthroughs, AI search notes, and adoption strategy, written by the people doing the work at NCR Digital."
>
  <Navigation />

  <main id="main-content">
    <SectionHero
      eyebrow="Insights"
      title="Notes from the work"
      subtitle="Technical SEO breakdowns and AI strategy notes, written by the people doing the work."
      size="lg"
    />

    <section class="py-16 sm:py-24 bg-ncr-surface" aria-labelledby="posts-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="posts-heading" class="sr-only">All posts</h2>

        {posts.length === 0 ? (
          <div class="text-center py-24">
            <p class="text-ncr-muted text-sm">No posts yet. Check back soon.</p>
          </div>
        ) : (
          <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {posts.map((post) => (
              <li role="listitem">
                <a
                  href={`/insights/${post.slug}/`}
                  class="group flex flex-col h-full bg-ncr-card border border-ncr-border rounded-card overflow-hidden hover:border-ncr-accent transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ncr-accent"
                  aria-label={`Read: ${post.data.title}`}
                >
                  <div class="aspect-[16/9] bg-ncr-surface border-b border-ncr-border relative overflow-hidden flex items-center justify-center">
                    {post.data.image ? (
                      <img
                        src={post.data.image}
                        alt={post.data.imageAlt ?? post.data.title}
                        width="640"
                        height="280"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="font-display text-ncr-accent/15 text-4xl select-none" aria-hidden="true">NCR</span>
                    )}
                  </div>

                  <div class="flex flex-col flex-1 p-7">
                    <div class="flex items-center gap-3 mb-4">
                      <span class="text-[11px] tracking-wide uppercase text-ncr-accent bg-ncr-surface rounded-pill px-2.5 py-1">
                        {capabilityBySlug[post.data.category]?.label ?? post.data.category}
                      </span>
                      <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ncr-muted tracking-wide">
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>

                    <h3 class="font-display text-ncr-text text-xl leading-snug mb-3 group-hover:text-ncr-accent transition-colors duration-200">
                      {post.data.title}
                    </h3>

                    <p class="text-ncr-muted text-sm leading-relaxed flex-1">
                      {post.data.description}
                    </p>

                    <div class="mt-6 text-sm text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 group-hover:decoration-ncr-accent transition-colors duration-200">
                      Read article
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
