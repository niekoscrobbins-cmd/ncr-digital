---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  marketing: 'Marketing',
  finance: 'Finance',
  operations: 'Operations',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="Insights | NCR Digital"
  description="Practitioner-level writing on AI-era marketing (GEO and technical SEO), finance strategy, and AI adoption, from the team at NCR Digital."
>
  <Navigation />

  <main id="main-content">
    <SectionHero
      eyebrow="Insights"
      title="Marketing, Finance, and Operations: Explained by the People Doing the Work"
      subtitle="Strategy frameworks, technical walkthroughs, and data-backed analysis across all three NCR Digital pillars."
      size="lg"
    />

    <section class="py-16 sm:py-24 bg-ncr-surface" aria-labelledby="posts-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="posts-heading" class="sr-only">All posts</h2>

        {posts.length === 0 ? (
          <div class="text-center py-24">
            <p class="font-mono text-ncr-muted text-sm">No posts yet. Check back soon.</p>
          </div>
        ) : (
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {posts.map((post) => (
              <li role="listitem">
                <a
                  href={`/insights/${post.slug}/`}
                  class="group flex flex-col h-full bg-ncr-card border border-ncr-border hover:border-ncr-cyan transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ncr-cyan"
                  aria-label={`Read: ${post.data.title}`}
                >
                  <div class="aspect-[16/7] bg-ncr-bg border-b border-ncr-border relative overflow-hidden flex items-center justify-center">
                    {post.data.image ? (
                      <img
                        src={post.data.image}
                        alt={post.data.imageAlt ?? post.data.title}
                        width="640"
                        height="280"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="font-mono text-ncr-cyan/20 text-4xl font-bold select-none" aria-hidden="true">NCR</span>
                    )}
                  </div>

                  <div class="flex flex-col flex-1 p-7">
                    <div class="flex items-center gap-3 mb-4">
                      <span class="font-mono text-[10px] tracking-widest uppercase text-ncr-cyan border border-ncr-cyan/40 px-2 py-0.5">
                        {categoryLabels[post.data.category]}
                      </span>
                      <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ncr-muted tracking-wide">
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>

                    <h3 class="text-ncr-text font-bold text-lg leading-snug mb-3 group-hover:text-ncr-cyan transition-colors duration-200">
                      {post.data.title}
                    </h3>

                    <p class="text-ncr-muted text-sm leading-relaxed flex-1">
                      {post.data.description}
                    </p>

                    <div class="mt-6 flex items-center gap-1.5 font-mono text-xs text-ncr-cyan tracking-widest uppercase group-hover:gap-3 transition-all duration-200">
                      Read Article
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                        <path d="M2 6h8M6 2l4 4-4 4"/>
                      </svg>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
