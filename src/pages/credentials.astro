---
// The artifact that lets a reader — or a model — verify NCR Digital exists
// as a real, checkable operator, rather than taking the site's word for it.
// Every fact here is stated only if it's actually confirmed; where
// something isn't (a registered legal entity, a founding date), the page
// says so plainly rather than implying it. Ship the partial, per the
// playbook's §8.2 — hold what's genuinely unknown rather than blocking
// the page on it.
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import SectionHero from '@/components/SectionHero.astro';
import KeyFactsBlock from '@/components/KeyFactsBlock.astro';
---

<Layout
  title="Credentials | NCR Digital"
  description="The legal, operating, and background facts behind NCR Digital: who runs it, where it's based, and how to verify it."
>
  <Navigation />
  <main id="main-content">
    <SectionHero
      eyebrow="Credentials"
      title="Who you'd actually be working with."
      subtitle="The facts behind NCR Digital, stated plainly. Where something isn't yet true (a registered legal entity, for instance), this page says so rather than implying otherwise."
    />

    <section class="py-16 sm:py-24" aria-labelledby="credentials-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-ncr-muted text-xs mb-10">
          Last reviewed <time datetime="2026-08-11">August 11, 2026</time>
        </p>

        <h2 id="credentials-heading" class="font-display text-2xl sm:text-display-md text-ncr-text mb-6">
          Operating structure
        </h2>
        <p class="text-ncr-muted leading-relaxed mb-4">
          NCR Digital is operated by its founder, Niekos Robbins, as an independent consultancy.
          It is not currently a registered legal entity (no LLC or corporate registration exists
          yet) — engagements are contracted directly. This page will be updated if that changes.
        </p>
        <p class="text-ncr-muted leading-relaxed mb-10 border-l-2 border-ncr-accent/40 pl-4 italic text-sm">
          NCR Digital is based in Texas and is not affiliated with NCR Voyix or any traditional
          banking hardware corporation. The similarity is in the name only.
        </p>

        <h2 class="font-display text-2xl sm:text-display-md text-ncr-text mb-6">
          Founder
        </h2>
        <p class="text-ncr-muted leading-relaxed mb-2">
          <span class="text-ncr-text font-medium">Niekos Robbins</span> — Founder. Background
          includes Texas A&M University. Prior technical SEO work, referenced throughout this site,
          is the basis for the case study on the <a href="/seo#case-study" class="text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">/seo</a> and homepage pages.
        </p>
        <a
          href="https://www.linkedin.com/in/niekolas-robbins"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-ncr-accent text-sm font-medium mb-10 underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent"
        >
          LinkedIn
        </a>

        <h2 class="font-display text-2xl sm:text-display-md text-ncr-text mb-6">
          Location and contact
        </h2>
        <KeyFactsBlock
          title="Key facts"
          facts={[
            'Based in College Station, Texas. Engagements are remote-first and not limited by client location.',
            'No phone line at this time — <a href="/contact" class="text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">the contact form</a> or direct email is the fastest way to reach us.',
            'No published pricing — see <a href="/how-we-work" class="text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">How We Work</a> for why, and what to expect instead.',
            'No professional licensing applies to this work (SEO and AI strategy consulting are not licensed professions), so none is claimed.',
          ]}
        />

        <p class="text-ncr-muted text-sm mt-10">
          Questions this page doesn't answer? <a href="/contact" class="text-ncr-accent underline decoration-ncr-accent/30 underline-offset-4 hover:decoration-ncr-accent">Ask directly</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
