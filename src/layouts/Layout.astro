---
import { ORG_ID, FOUNDER_ID } from '@/lib/schema';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = 'NCR Digital | AI Strategy for Marketing, Finance & Operations',
  description = 'NCR Digital is a boutique AI strategy consultancy helping high-growth companies win visibility in AI-answer search, sharpen financial strategy, and adopt AI operationally.',
  canonicalUrl = new URL(Astro.url.pathname, 'https://ncrdigi.com').href,
  ogImage = 'https://ncrdigi.com/og-main-cover.png',
} = Astro.props;

// Sitewide entity graph: Organization + founder Person, both carrying stable
// @ids so pillar-page Service nodes and per-post BlogPosting nodes can
// reference them instead of duplicating the same data inline.
// TODO: add Person.image once a founder photo asset exists (see plan Phase 3).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'NCR Digital',
      url: 'https://ncrdigi.com',
      logo: 'https://ncrdigi.com/og-main-cover.png',
      description,
      // TODO: Update email to branded domain address (e.g. hello@ncrdigi.com) once email is configured
      email: 'niekos.c.robbins+ncr@gmail.com',
      founder: { '@id': FOUNDER_ID },
      areaServed: 'Worldwide',
      knowsAbout: ['AI Strategy', 'Generative Engine Optimization', 'Technical SEO', 'FP&A', 'AI Adoption Strategy'],
    },
    {
      '@type': 'Person',
      '@id': FOUNDER_ID,
      name: 'Niekos Robbins',
      url: 'https://ncrdigi.com/about',
      sameAs: ['https://www.linkedin.com/in/niekolas-robbins'],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Texas A&M University',
      },
      worksFor: { '@id': ORG_ID },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NCR Digital" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <slot name="head" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FT90Q38Q45"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FT90Q38Q45');
    </script>
  </head>

  <body class="bg-ncr-bg text-ncr-text antialiased font-sans">
    <slot />
  </body>
</html>

<style is:global>
  /* Custom scrollbar, light theme */
  ::-webkit-scrollbar          { width: 5px; }
  ::-webkit-scrollbar-track    { background: #f7f8fa; }
  ::-webkit-scrollbar-thumb    { background: #cbd2dc; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #0072ce; }

  /* Smooth focus outlines */
  :focus-visible { outline: 2px solid #0072ce; outline-offset: 2px; }

  /* Selection color */
  ::selection { background: rgba(0, 114, 206, 0.15); color: #0b0e14; }
</style>

<script>
  // Sitewide scroll-reveal: progressively enhances any `.reveal`-wrapped
  // content (see ScrollReveal.astro). Resting state in CSS is always fully
  // visible; this script only ever adds a `.js-enabled` class (which the
  // stylesheet gates behind `prefers-reduced-motion: no-preference`) and
  // then flips `.revealed` on intersection. JS-disabled and reduced-motion
  // users both simply see the already-visible resting state.
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  if (revealEls.length) {
    revealEls.forEach((el) => el.classList.add('js-enabled'));
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => observer.observe(el));
  }
</script>