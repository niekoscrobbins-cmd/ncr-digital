---
// Self-hosted fonts, bundled by Astro rather than fetched from a third-party
// CDN — a firm that sells Core Web Vitals work should not ship a
// render-blocking cross-origin font request. Each file declares
// unicode-range per subset, so browsers only download the latin cut.
// `wght.css` is the weight axis alone: no optical-size axis, no italics.
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import { SITE_URL, ORG_ID, FOUNDER_ID, WEBSITE_ID } from '@/lib/schema';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = 'NCR Digital | SEO & AI Strategy',
  description = 'NCR Digital is a boutique consultancy doing two things: technical SEO and AI-answer visibility, and AI strategy consulting grounded in financial modeling.',
  canonicalUrl = new URL(Astro.url.pathname, 'https://ncrdigi.com').href,
  ogImage = 'https://ncrdigi.com/og-main-cover.png',
} = Astro.props;

// Sitewide entity graph: Organization + founder Person + WebSite, all
// carrying stable @ids so capability-page Service nodes and per-post
// BlogPosting nodes can reference them instead of duplicating the same
// data inline. Enriched once, per the plan's "one schema pass, then stop"
// rule — see src/pages/credentials.astro for the human-readable version of
// every fact asserted here. Deliberately NOT included: legalName and
// foundingDate (NCR Digital isn't a registered legal entity yet — asserting
// either would be fabricating a claim /credentials explicitly says isn't
// true), telephone (none exists), and priceRange (pricing stays unpublished
// by design, see /how-we-work).
// TODO: add Person.image once a founder photo asset exists.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': ORG_ID,
      name: 'NCR Digital',
      url: 'https://ncrdigi.com',
      logo: 'https://ncrdigi.com/og-main-cover.png',
      description,
      // TODO: Update email to branded domain address (e.g. hello@ncrdigi.com) once email is configured
      email: 'niekos.c.robbins+ncr@gmail.com',
      founder: { '@id': FOUNDER_ID },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'College Station',
        addressRegion: 'TX',
        addressCountry: 'US',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: 'niekos.c.robbins+ncr@gmail.com',
        url: 'https://ncrdigi.com/contact',
      },
      sameAs: ['https://www.linkedin.com/in/niekolas-robbins'],
      areaServed: 'Worldwide',
      knowsAbout: ['Technical SEO', 'Generative Engine Optimization', 'Organic Lead Generation', 'AI Strategy Consulting', 'AI Adoption Strategy'],
    },
    {
      '@type': 'Person',
      '@id': FOUNDER_ID,
      name: 'Niekos Robbins',
      url: 'https://ncrdigi.com/about',
      jobTitle: 'Founder',
      description: 'Founder of NCR Digital. Prior technical SEO work scaling organic search for a high-growth automotive SaaS platform is the basis for the case study referenced across this site.',
      sameAs: ['https://www.linkedin.com/in/niekolas-robbins'],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Texas A&M University',
      },
      worksFor: { '@id': ORG_ID },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      url: SITE_URL,
      name: 'NCR Digital',
      publisher: { '@id': ORG_ID },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="NCR Digital" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* SVG first for modern browser tabs; PNG fallbacks because Google's
        search-results favicon crawler has inconsistent SVG support and
        documents a preference for a raster icon sized a multiple of 48px.
        Without these, Search Console can keep serving a stale/cached icon
        indefinitely even after the live favicon changes. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <slot name="head" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FT90Q38Q45"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FT90Q38Q45');
    </script>
  </head>

  <body class="bg-ncr-bg text-ncr-text antialiased font-sans">
    <slot />
  </body>
</html>

<style is:global>
  /* Palette tokens mirrored from tailwind.config.mjs. These few global rules
     can't reach Tailwind's theme, so the values are declared once here as
     custom properties instead of being hand-duplicated at each use site. */
  :root {
    --ncr-surface: #f2eee8;
    --ncr-border:  #ded7cb;
    --ncr-rule:    #c9c0b2;
    --ncr-text:    #1b1917;
    --ncr-muted:   #6b645c;
    --ncr-accent:  #173248;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar          { width: 5px; }
  ::-webkit-scrollbar-track    { background: var(--ncr-surface); }
  ::-webkit-scrollbar-thumb    { background: var(--ncr-rule); border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--ncr-accent); }

  /* Smooth focus outlines */
  :focus-visible { outline: 2px solid var(--ncr-accent); outline-offset: 2px; }

  /* Selection color */
  ::selection { background: rgba(23, 50, 72, 0.14); color: var(--ncr-text); }
</style>

<script>
  // Sitewide scroll-reveal: progressively enhances any `.reveal`-wrapped
  // content (see ScrollReveal.astro). Resting state in CSS is always fully
  // visible; this script only ever adds a `.js-enabled` class (which the
  // stylesheet gates behind `prefers-reduced-motion: no-preference`) and
  // then flips `.revealed` on intersection. JS-disabled and reduced-motion
  // users both simply see the already-visible resting state.
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  if (revealEls.length) {
    revealEls.forEach((el) => el.classList.add('js-enabled'));
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => observer.observe(el));
  }
</script>