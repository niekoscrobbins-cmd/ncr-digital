---
export interface Props {
  facts: string[];
  title?: string;
}

const { facts, title = 'Key Facts' } = Astro.props;
---

<aside class="border border-ncr-border rounded-card bg-ncr-surface p-6 sm:p-8 my-8" aria-label={title}>
  <p class="text-xs tracking-wide uppercase text-ncr-muted mb-4">{title}</p>
  <ul class="space-y-3">
    {facts.map((fact) => (
      <li class="text-ncr-text text-sm sm:text-base leading-relaxed pl-4 border-l-2 border-ncr-accent/40">
        <span set:html={fact} />
      </li>
    ))}
  </ul>
</aside>
