---
export interface Props {
  facts: string[];
  title?: string;
}

const { facts, title = 'Key Facts' } = Astro.props;
---

<aside class="border border-ncr-border bg-ncr-surface p-6 sm:p-8 my-8" aria-label={title}>
  <p class="font-mono text-ncr-cyan text-xs tracking-[0.3em] uppercase mb-4">{title}</p>
  <ul class="space-y-3">
    {facts.map((fact) => (
      <li class="flex items-start gap-3 text-ncr-text text-sm sm:text-base leading-relaxed">
        <span class="text-ncr-cyan font-mono mt-0.5 flex-shrink-0" aria-hidden="true">→</span>
        <span set:html={fact} />
      </li>
    ))}
  </ul>
</aside>
