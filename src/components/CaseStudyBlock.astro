---
// The one existing case study: dropped into the homepage and the /seo page
// without duplicating markup. All numbers, labels, and the attribution
// framing come from src/data/proof.ts — the canonical fact set — so this
// component and StatBar (src/pages/index.astro) can never disagree about
// what a figure means or what window it covers. See proof.ts for the
// history of what used to be wrong here.
import { caseStudy } from '@/data/proof';

export interface Props {
  id?: string;
}

const { id = 'case-study' } = Astro.props;
---

<section id={id} class="py-16 sm:py-24" aria-labelledby="casestudy-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-14 max-w-2xl">
      <p class="text-xs tracking-wide uppercase text-ncr-muted mb-4">Case study</p>
      <h2 id="casestudy-heading" class="font-display text-3xl sm:text-display-md text-ncr-text">
        Proven results
      </h2>
    </header>

    <div class="border border-ncr-border rounded-card bg-ncr-card">
      <div class="p-8 lg:p-14">
        <p class="text-xs tracking-wide uppercase text-ncr-muted mb-2">
          {caseStudy.client}
        </p>
        <p class="text-xs text-ncr-muted mb-10">
          {caseStudy.attribution} · {caseStudy.window}
        </p>

        <div class="grid lg:grid-cols-2 gap-14 items-start">
          <div>
            <h3 class="font-display text-2xl sm:text-3xl mb-5 leading-tight text-ncr-text">
              Domain Rating<br />
              <span class="text-ncr-accent">20 → 44</span> in 7 months
            </h3>
            <p class="text-ncr-muted leading-relaxed mb-2 max-w-xl">
              A full-stack technical SEO transformation for {caseStudy.client}.
              Rebuilt content silos by search intent, resolved Core Web Vitals deficits, deployed
              programmatic JSON-LD schema at scale, and ran a targeted link-building and disavow
              campaign. A stagnant domain became a compounding organic asset.
            </p>
            <p class="text-ncr-muted text-xs mb-10">
              Every figure below is sourced to the tool that produced it and states its own
              measurement window — no rounding, no unscoped comparisons.
            </p>

            <div class="grid grid-cols-2 gap-5" role="list" aria-label="Case study metrics">
              {caseStudy.metrics.map(({ value, label, sub, source, prefix, countFrom, countTo, decimals, suffix }) => (
                <div class="border-l-2 border-ncr-accent pl-4 py-1" role="listitem">
                  <p
                    class="metric-value font-mono text-2xl font-semibold text-ncr-accent"
                    data-count-from={countFrom}
                    data-count-to={countTo}
                    data-decimals={decimals}
                    data-prefix={prefix}
                    data-suffix={suffix}
                  >
                    {value}
                  </p>
                  <p class="text-ncr-text text-sm font-medium mt-0.5">{label}</p>
                  <p class="text-ncr-muted text-xs mt-0.5">{sub} · {source}</p>
                </div>
              ))}
            </div>
          </div>

          <div aria-label="Domain Rating progression chart" role="figure">
            <p class="text-xs tracking-wide uppercase text-ncr-muted mb-1">DR trajectory (Ahrefs)</p>
            <p class="text-ncr-muted text-xs mb-5">Bars are scaled to their own 0-100 axis.</p>
            <div class="space-y-3">
              {caseStudy.drProgress.map(({ month, dr }) => (
                <div class="flex items-center gap-3">
                  <span class="font-mono text-xs text-ncr-muted w-16 flex-shrink-0">{month}</span>
                  <div class="flex-1 h-6 bg-ncr-surface rounded-full relative overflow-hidden" role="progressbar" aria-valuenow={dr} aria-valuemin={0} aria-valuemax={100} aria-label={`Domain Rating ${dr}`}>
                    <div class="dr-bar-fill absolute inset-y-0 left-0 bg-ncr-accent/25 rounded-full" data-target-width={dr} style={`width: ${dr}%`}></div>
                    <span class="absolute right-2.5 top-1/2 -translate-y-1/2 font-mono text-xs text-ncr-accent font-semibold">
                      {dr}
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-8 pt-6 border-t border-ncr-border">
              <p class="text-xs tracking-wide uppercase text-ncr-muted mb-4">Levers pulled</p>
              <ul class="space-y-2">
                {caseStudy.leversPulled.map((item) => (
                  <li class="text-sm text-ncr-muted pl-4 border-l border-ncr-border">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
