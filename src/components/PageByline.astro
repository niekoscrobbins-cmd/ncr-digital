---
export interface Props {
  author: string;
  publishedDate: Date;
  updatedDate?: Date;
}

const { author, publishedDate, updatedDate } = Astro.props;

// `timeZone: 'UTC'` matters here: dates from frontmatter/literals like
// `new Date('2026-03-01')` parse as UTC midnight, and without pinning the
// zone this formats in whatever zone the build runs in — rendering one day
// earlier locally than on a UTC build server, so the visible text and the
// machine-readable `datetime` attribute below would disagree.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<p class="text-ncr-muted text-sm flex flex-wrap gap-x-2 gap-y-1">
  <span>By <span class="text-ncr-text font-medium">{author}</span></span>
  <span aria-hidden="true">·</span>
  <span>Published <time datetime={publishedDate.toISOString()}>{fmt(publishedDate)}</time></span>
  {updatedDate && (
    <>
      <span aria-hidden="true">·</span>
      <span>Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>
    </>
  )}
</p>
