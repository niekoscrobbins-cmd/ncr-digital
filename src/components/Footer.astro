---
import { navLinks, contactHref } from '@/data/nav';

const year = new Date().getFullYear();
---

<footer class="border-t border-ncr-border bg-ncr-bg py-12" aria-label="Site footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">

      <!-- Logo + tagline -->
      <div>
        <a href="/" class="font-display text-lg" aria-label="NCR Digital home">
          <span class="text-ncr-text">NCR</span><span class="text-ncr-accent">D</span><span class="text-ncr-text">igital</span>
        </a>
        <p class="text-ncr-muted text-xs mt-2">Organic search and AI strategy, built on measurement.</p>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-8 gap-y-2">
          {navLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-ncr-muted hover:text-ncr-text text-sm transition-colors duration-200"
              >
                {label}
              </a>
            </li>
          ))}
          <li>
            <a href="/credentials" class="text-ncr-muted hover:text-ncr-text text-sm transition-colors duration-200">
              Credentials
            </a>
          </li>
          <li>
            <a
              href={contactHref}
              class="text-ncr-muted hover:text-ncr-text text-sm transition-colors duration-200"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Divider -->
    <div class="mt-10 pt-8 border-t border-ncr-border flex flex-col sm:flex-row items-center justify-between gap-4 text-ncr-muted text-xs">
      <p>© {year} NCR Digital. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a
          href="https://www.linkedin.com/in/niekolas-robbins"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ncr-accent transition-colors"
        >
          LinkedIn
        </a>
        <a href="mailto:niekos.c.robbins+ncr@gmail.com" class="hover:text-ncr-accent transition-colors">
          niekos.c.robbins+ncr@gmail.com
        </a>
      </div>
    </div>
  </div>
</footer>
