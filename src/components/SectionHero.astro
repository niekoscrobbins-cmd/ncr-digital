---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  align?: 'left' | 'center';
  size?: 'xl' | 'lg';
}

const {
  eyebrow,
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  align = 'left',
  size = 'xl',
} = Astro.props;

const alignClass = align === 'center' ? 'items-center text-center mx-auto' : 'items-start text-left';
const titleClass = size === 'xl' ? 'text-4xl sm:text-display-lg lg:text-display-xl' : 'text-4xl sm:text-display-md lg:text-display-lg';
---

<section class="relative pt-32 pb-16 sm:pt-40 sm:pb-24 bg-ncr-bg overflow-hidden">
  <slot name="background" />
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`flex flex-col gap-6 max-w-4xl ${alignClass}`}>
      {eyebrow && (
        <p class="font-mono text-ncr-cyan text-xs tracking-[0.3em] uppercase flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-ncr-cyan" aria-hidden="true"></span>
          {eyebrow}
        </p>
      )}
      <h1 class={`${titleClass} font-extrabold tracking-tight text-ncr-text`}>
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg sm:text-xl text-ncr-muted leading-relaxed max-w-2xl">
          {subtitle}
        </p>
      )}
      {(ctaLabel || secondaryCtaLabel) && (
        <div class="flex flex-wrap gap-4 mt-2">
          {ctaLabel && ctaHref && (
            <a
              href={ctaHref}
              class="px-6 py-3 bg-ncr-cyan text-white text-sm font-medium tracking-wide hover:bg-ncr-cyan/90 active:scale-[0.98] transition-all duration-200"
            >
              {ctaLabel}
            </a>
          )}
          {secondaryCtaLabel && secondaryCtaHref && (
            <a
              href={secondaryCtaHref}
              class="px-6 py-3 border border-ncr-border text-ncr-text text-sm font-medium tracking-wide hover:border-ncr-cyan hover:text-ncr-cyan transition-all duration-200"
            >
              {secondaryCtaLabel}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
